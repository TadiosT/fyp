experimental_notebooks/**/audio_files_144/
experimental_notebooks/**/snapshots/
experimental_notebooks/**/snapshots_cropped/

# Coverage tool output (regenerate with: venv/bin/python -m pytest --cov)
data/eval/coverage*.json

# Notebook artefacts derived from the lecture recording (identifiable people)
experimental_notebooks/Lecture_Hall_Occupancy/final_occupancy_heatmap.png

# Superseded mock-log intermediates kept locally for provenance only
experimental_notebooks/Computing_Lab_Usage/huxley_mock_access_logs_updated.csv
experimental_notebooks/Computing_Lab_Usage/huxley_mock_access_logs_pinpoint.csv

